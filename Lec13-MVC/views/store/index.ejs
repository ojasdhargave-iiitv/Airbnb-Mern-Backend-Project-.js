<%- include('../partials/pageTitle')%>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <%- include('../partials/nav')%>
    <main class="mt-20">
      <div class="text-center text-6xl">
        <h1 class="text-3xl font-semibold text-gray-800 mb-4">Welcome to Airbnb</h1>
      </div>

      <div class="bg-white rounded-xl shadow-lg p-10 w-full max-w-xl mx-auto text-center">
        <h2 class="text-3xl font-semibold text-gray-800 mb-4">Become a Host</h2>
        <p class="text-gray-600 mb-8">Share your space and start earning today!</p>
        <a href="/host/add-homes" class="inline-block bg-red-400 hover:bg-red-500 text-white font-bold py-3 px-8 rounded-lg shadow transition duration-200">
          Add Homes
        </a>
      </div>
      <div class="bg-white rounded-xl shadow-lg p-4 w-full max-w-6xl mx-auto mt-8">
        <h2 class="text-2xl font-bold text-red-500 mb-6 text-center">Here are our Registered Homes:</h2>
       <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6 p-4">
  <% registeredhomes.forEach((home) => { %>
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
            <!-- Image -->
            <div class="w-full h-48 overflow-hidden">
              <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb" 
                  alt="Home Photo" 
                  class="w-full h-full object-cover hover:scale-110 transition-transform duration-500" />
            </div>

            <!-- Content -->
            <div class="p-4 flex flex-col justify-between">
              <h3 class="text-lg font-semibold text-gray-800 mb-1 break-words"><%= home.houseName %></h3>
              <p class="text-gray-500 text-sm mb-2 break-words"><%= home.location %></p>

              <div class="flex items-center justify-between mt-2">
                <span class="text-red-500 font-bold text-lg">
                  ₹<%= home.price %><span class="text-gray-500 text-sm"> /Night</span>
                </span>
              </div>

              <div class="flex items-center mt-2">
                <span class="text-yellow-500">★</span>
                <span class="text-gray-700 font-medium ml-1"><%= home.rating %></span>
              </div>

              <!-- Buttons -->
              <div class="flex gap-3 mt-4">
                <button class="flex-1 bg-green-500 hover:green-blue-600 text-white font-bold py-2 px-4 rounded-lg shadow transition duration-200">
                  Book
                </button>
              </div>
        </div>
    </div>
  <% }) %>
</div>

      </div>
    </main>
    <footer class="mt-24 py-6 text-center text-gray-500 text-sm">
      &copy; 2025 Airbnb Clone. All rights reserved.
    </footer>
  </body>
</html>