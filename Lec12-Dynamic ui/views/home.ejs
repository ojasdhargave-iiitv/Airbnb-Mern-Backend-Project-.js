<%- include('partials/pageTitle')%>
  </head>
  <body class="bg-gray-50 min-h-screen">
    <%- include('partials/nav')%>
    <main class="flex flex-col items-center justify-center mt-20">
      <div class="bg-white rounded-xl shadow-lg p-10 w-full max-w-md text-center">
        <h2 class="text-3xl font-semibold text-gray-800 mb-4">Become a Host</h2>
        <p class="text-gray-600 mb-8">Share your space and start earning today!</p>
        <a href="/host/add-homes" class="inline-block bg-red-400 hover:bg-red-500 text-white font-bold py-3 px-8 rounded-lg shadow transition duration-200">
          Add Homes
        </a>
      </div>
      <div class="bg-white rounded-xl shadow-lg p-8 w-full max-w-5xl mt-8">
        <h2 class="text-2xl font-bold text-red-500 mb-6 text-center">Here are our Registered Homes:</h2>
        <div class="flex flex-wrap gap-8 justify-center">
          <% registeredhomes.forEach((home) => { %>
            <div class="inline-block align-top bg-white rounded-3xl shadow-2xl border border-gray-100 p-5 mx-2 my-4 w-72 h-[420px] hover:scale-105 hover:shadow-3xl transition-all duration-300">
              <div class="w-full h-48 overflow-hidden rounded-2xl mb-3 bg-gray-100 flex items-center justify-center">
                <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb" alt="Home Photo" class="w-full h-full object-cover rounded-2xl shadow" />
              </div>
              <div class="flex-1 flex flex-col justify-between px-2 py-2 w-full">
                <h3 class="text-xl font-bold text-gray-800 mb-1 truncate"><%= home.houseName %></h3>
                <p class="text-gray-500 mb-2"><span class="font-medium"></span> <span class="truncate"><%= home.location %></span></p>
                <p class="text-gray-600 mb-1"><span class="font-medium"></span> <span class="text-red-500 font-semibold">₹<%= home.price %></span> /Night</p>
                <div class="flex items-center mt-2">
                  <span class="text-yellow-500 text-lg mr-1">★</span>
                  <span class="text-gray-700 font-medium"><%= home.rating %></span>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </main>
    <footer class="mt-24 py-6 text-center text-gray-500 text-sm">
      &copy; 2025 Airbnb Clone. All rights reserved.
    </footer>
  </body>
</html>