<%- include('../partials/pageTitle')%>
    </head>
    <body class="bg-gray-50 min-h-screen flex flex-col">
        <!-- Header -->
        <%- include ('../partials/nav')%>
        <header class="bg-white shadow-md py-6 px-8 flex items-center justify-center mt-4 rounded-xl">
            <h1 class="text-3xl font-bold text-blue-600">Please <%=editing?"Edit":"Register"%> your Home</h1>
        </header>
        <!-- Main Content -->
        <main class="flex flex-1 flex-col items-center justify-center">
            <form action="/host/<%=editing?"edit-home":"add-homes"%>" method="POST" class="bg-white rounded-xl shadow-lg p-8 w-full max-w-md flex flex-col gap-6 mt-8">
                <input 
                    name="id" 
                    value="<%=editing?home.id:""%>"
                    type="hidden"
                >
                <input 
                    placeholder="Enter the home name" 
                    name="houseName" 
                    value="<%=editing?home.houseName:""%>"
                    type="text" 
                    class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black-400 text-gray-700"
                    required
                >
                <input 
                    placeholder="Price per Night" 
                    value="<%=editing?home.price:''%>"
                    name="price" 
                    type="text" 
                    class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black-400 text-gray-700"
                    required
                >
                <input 
                    placeholder="Home location" 
                    value="<%=editing?home.location:''%>"
                    name="location" 
                    type="text" 
                    class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black-400 text-gray-700"
                    required
                >
                <input 
                    placeholder="Ratings" 
                    value="<%=editing?home.rating:''%>"
                    name="rating" 
                    type="text" 
                    class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black-400 text-gray-700"
                    required
                >
                <input 
                    placeholder="PhotoURL" 
                    value="<%=editing?home.photo:''%>"
                    name="photo" 
                    type="text" 
                    class="border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-black-400 text-gray-700"
                    required
                >

                <input 
                    type="submit" value="<%=editing?"Update":"Add home"%>"
                    class="bg-black hover:bg-gray-800 text-white font-semibold py-3 px-6 rounded-lg shadow transition duration-200">
            </form>
        </main>
        <!-- Footer -->
        <footer class="mt-12 py-4 text-center">
            <a href="/" class="text-gray-500 hover:text-blue-500 underline">Back to Airbnb Home page</a>
        </footer>
    </body>
</html>